---
const name = 'Drew Linerud';
const title = 'Principal Software Engineer at Microsoft';
const positioning =
  'Tech owner of the Windows voice-activation platform — the system powering "Hey Copilot" on modern Windows PCs. I design and ship the Windows platforms that other engineers depend on every day.';
const location = 'Duvall, Washington';

const work = [
  {
    name: 'Windows voice-activation platform ("Hey Copilot")',
    role: 'Tech owner',
    impact:
      'Single technical point of contact across Microsoft AI, Surface, Windows audio, and silicon partners (Intel, Qualcomm, AMD). Drove the HW-vs-SW keyword spotting power decision that delivered a 50–100x efficiency win — a key driver of the Surface "PC you can talk to" claim.',
  },
  {
    name: 'Windows Text Input Virtualization',
    role: 'Architect',
    impact:
      'Multi-release platform delivering high-fidelity, like-local text input inside Windows containers and remote sessions. Authored the 92-page MS-RDPETXT public RDP protocol, engaged Citrix as a third-party adopter.',
    link: 'https://learn.microsoft.com/openspecs/windows_protocols/ms-rdpetxt/',
    linkLabel: 'MS-RDPETXT spec',
  },
  {
    name: 'Modern Windows IME platform',
    role: 'API designer',
    impact:
      'Designed the WinRT API surface (CoreTextEditBuffer/View, SystemInputProcessor) adopted by the Chinese IME, Korean TSF3 IME, Handwriting Panel, and Expressive Input — serving 100M+ monthly users.',
  },
  {
    name: 'Windows input reliability',
    role: 'Multi-cycle lead',
    impact:
      '~40% prior-cycle reduction in ctfmon Watson crashes plus ~50M additional crashes addressed this cycle across the global Windows install base.',
  },
  {
    name: 'MonoMano',
    role: 'Creator (Microsoft Hackathon)',
    impact:
      'One-handed typing IME for users with limb difference or hand injury. Built as an accessibility incubation project.',
  },
];

const links = [
  { label: 'Email', href: 'mailto:drew@linerud.dev', text: 'drew@linerud.dev' },
  { label: 'GitHub', href: 'https://github.com/drew-linerud', text: 'github.com/drew-linerud' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/drew-linerud-0a69353/', text: 'linkedin.com/in/drew-linerud' },
];

const description =
  'Drew Linerud — Principal Software Engineer at Microsoft. Tech owner of the Windows voice-activation platform powering "Hey Copilot".';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{name} — {title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://linerud.dev/" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`${name} — ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://linerud.dev/" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E📡%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <main>
      <header class="hero">
        <h1>{name}</h1>
        <p class="title">{title}</p>
        <p class="positioning">{positioning}</p>
        <p class="meta">{location} · <a href="mailto:drew@linerud.dev">drew@linerud.dev</a></p>
      </header>

      <section aria-labelledby="about">
        <h2 id="about">About</h2>
        <p>
          I work at the layer of Windows where platforms meet products. For the last cycle that's meant
          owning the Windows voice-activation platform — the system that lets you say "Hey Copilot" to
          your PC and have something useful happen. Before that I architected Windows Text Input
          Virtualization, designed the modern IME API surface used by hundreds of millions of people,
          and shipped reliability fixes addressing tens of millions of crashes.
        </p>
        <p>
          The throughline of my career is building Windows platforms that other engineers depend on
          every day — quietly, reliably, at scale. I care about the interfaces between teams almost
          as much as the interfaces between components, and I care about shipping things that outlast
          the org chart that birthed them.
        </p>
        <p>
          Outside work I ride bikes, play speed chess, and write science fiction and fantasy. The
          writing turns out to be excellent practice for the era where natural language is the
          primary medium of software design.
        </p>
      </section>

      <section aria-labelledby="work">
        <h2 id="work">Selected work</h2>
        <ul class="work-list">
          {work.map((w) => (
            <li>
              <div class="work-head">
                <span class="work-name">{w.name}</span>
                <span class="work-role">{w.role}</span>
              </div>
              <p class="work-impact">
                {w.impact}
                {w.link && (
                  <>
                    {' '}
                    <a href={w.link}>{w.linkLabel ?? 'Link'} →</a>
                  </>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact">Reach out</h2>
        <p>
          I'm happy to talk to engineers about Windows platforms, voice and input, navigating big-company
          technical strategy, or shipping things that outlast you. Email is the fastest way to reach me.
        </p>
        <ul class="links">
          {links.map((l) => (
            <li>
              <span class="link-label">{l.label}</span>
              <a href={l.href}>{l.text}</a>
            </li>
          ))}
        </ul>
      </section>

      <footer>
        <p>© {new Date().getFullYear()} Drew Linerud</p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #fafafa;
        --muted: #5a5a5a;
        --muted-2: #888;
        --accent: #0b66c3;
        --rule: rgba(0, 0, 0, 0.08);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e8e8e8;
          --bg: #0e0f10;
          --muted: #b0b3b8;
          --muted-2: #7a7d80;
          --accent: #6cb1ff;
          --rule: rgba(255, 255, 255, 0.1);
        }
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Inter, sans-serif;
        line-height: 1.65;
        font-size: 17px;
      }
      a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 120ms ease;
      }
      a:hover { border-bottom-color: var(--accent); }
      main {
        max-width: 44rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 6rem;
      }
      .hero h1 {
        font-size: clamp(2rem, 4vw, 2.75rem);
        margin: 0 0 0.25rem;
        letter-spacing: -0.02em;
      }
      .hero .title {
        margin: 0 0 1rem;
        color: var(--fg);
        font-weight: 500;
      }
      .hero .positioning {
        margin: 0 0 1rem;
        color: var(--muted);
        font-size: 1.05rem;
      }
      .hero .meta {
        margin: 0;
        color: var(--muted-2);
        font-size: 0.95rem;
      }
      section {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--rule);
      }
      h2 {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted-2);
        font-weight: 600;
        margin: 0 0 1rem;
      }
      p { margin: 0 0 1rem; color: var(--fg); }
      section p:last-child { margin-bottom: 0; }
      .work-list, .links {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .work-list > li {
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
      }
      .work-list > li:last-child { border-bottom: 0; padding-bottom: 0; }
      .work-list > li:first-child { padding-top: 0; }
      .work-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 0.35rem;
        flex-wrap: wrap;
      }
      .work-name { font-weight: 600; }
      .work-role {
        color: var(--muted-2);
        font-size: 0.9rem;
        font-style: italic;
      }
      .work-impact {
        margin: 0;
        color: var(--muted);
        font-size: 0.97rem;
      }
      .links li {
        display: flex;
        gap: 0.75rem;
        padding: 0.25rem 0;
      }
      .link-label {
        min-width: 5rem;
        color: var(--muted-2);
        font-size: 0.9rem;
      }
      footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--rule);
        color: var(--muted-2);
        font-size: 0.85rem;
      }
      footer p { color: var(--muted-2); margin: 0; }
      @media (max-width: 480px) {
        main { padding: 2.5rem 1.25rem 4rem; }
        .work-head { flex-direction: column; gap: 0.1rem; }
      }
    </style>
  </body>
</html>
